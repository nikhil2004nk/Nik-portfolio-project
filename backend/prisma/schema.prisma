generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                  String   @id @default(uuid())
  name                String
  headline            String
  tagline             String?
  bio                 String?
  email               String
  phone               String?
  location            String?
  resumeUrl           String?
  profileImage        String?
  coverImage          String?
  freelanceAvailable  Boolean  @default(false)
  remoteAvailable     Boolean  @default(false)
  relocationAvailable Boolean  @default(false)
  currentCompany      String?
  currentRole         String?
  yearsExperience     Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Social {
  id        String   @id @default(uuid())
  platform  String
  label     String
  url       String
  icon      String?
  visible   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible])
  @@index([order])
}

model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured])
  @@index([order])
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillCategory {
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
  CLOUD
  TOOL
  AI
  OTHER
}

model Skill {
  id                String         @id @default(uuid())
  name              String
  level             SkillLevel
  category          SkillCategory?
  icon              String?
  yearsOfExperience Float?
  order             Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([order])
  @@index([category])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERN
  FREELANCE
  CONTRACT
}

model Experience {
  id               String                  @id @default(uuid())
  company          String
  role             String
  location         String?
  companyLogo      String?
  employmentType   EmploymentType?
  currentlyWorking Boolean                 @default(false)
  startDate        DateTime
  endDate          DateTime?
  achievements     ExperienceAchievement[]
  order            Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([order])
}

model ExperienceAchievement {
  id           String     @id @default(uuid())
  title        String
  description  String?
  metric       String?
  order        Int        @default(0)
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([order])
}

model Education {
  id           String   @id @default(uuid())
  institution  String
  degree       String
  fieldOfStudy String?
  location     String?
  logo         String?
  grade        String?
  description  String?
  startYear    Int
  endYear      Int?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([order])
}

model Certification {
  id              String    @id @default(uuid())
  name            String
  org             String
  issueDate       DateTime?
  expiryDate      DateTime?
  credentialId    String?
  logo            String?
  verificationUrl String?
  published       Boolean   @default(true)
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published])
  @@index([order])
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

model ContactMessage {
  id          String        @id @default(uuid())
  name        String
  email       String
  phone       String?
  company     String?
  subject     String?
  message     String
  budget      String?
  projectType String?
  status      ContactStatus @default(NEW)
  isRead      Boolean       @default(false)
  repliedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([isRead])
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  role        String
  company     String
  companyLogo String?
  content     String
  avatarUrl   String?
  linkedin    String?
  rating      Int      @default(5)
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured])
  @@index([published])
  @@index([order])
}

enum ProjectStatus {
  COMPLETED
  IN_PROGRESS
  ARCHIVED
}

model Project {
  id           String              @id @default(uuid())
  name         String              @unique
  slug         String              @unique
  description  String
  coverImage   String?
  thumbnail    String?
  status       ProjectStatus       @default(COMPLETED)
  featured     Boolean             @default(false)
  published    Boolean             @default(true)
  order        Int                 @default(0)

  technologies ProjectTechnology[]
  features     ProjectFeature[]
  screenshots  ProjectScreenshot[]
  metrics      ProjectMetric[]
  tags         ProjectTag[]
  categories   ProjectCategory[]

  highlights   Json?
  caseStudy    Json?
  architecture Json?
  deployment   Json?
  timeline     Json?
  seo          Json?
  links        Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([featured])
  @@index([published])
  @@index([status])
  @@index([order])
}

enum ScreenshotType {
  DESKTOP
  MOBILE
  DASHBOARD
  GALLERY
  ADMIN
  OTHER
}

model ProjectScreenshot {
  id        String         @id @default(uuid())
  title     String
  imageUrl  String
  alt       String?
  type      ScreenshotType
  order     Int            @default(0)
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([order])
}

model ProjectFeature {
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int      @default(0)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model ProjectMetric {
  id        String   @id @default(uuid())
  label     String
  value     String
  order     Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

enum TechnologyCategory {
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
  CLOUD
  TOOL
  AI
  OTHER
}

model Technology {
  id               String              @id @default(uuid())
  name             String              @unique
  icon             String?
  color            String?
  officialWebsite  String?
  documentationUrl String?
  category         TechnologyCategory?
  featured         Boolean             @default(false)
  projects         ProjectTechnology[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([category])
  @@index([featured])
}

model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
}

model Tag {
  id        String       @id @default(uuid())
  name      String       @unique
  projects  ProjectTag[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model ProjectTag {
  projectId String
  tagId     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model Category {
  id        String            @id @default(uuid())
  name      String            @unique
  projects  ProjectCategory[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ProjectCategory {
  projectId  String
  categoryId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

model Admin {
  id        String    @id @default(uuid())
  name      String?
  email     String    @unique
  password  String
  lastLogin DateTime?
  role      AdminRole @default(ADMIN)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}